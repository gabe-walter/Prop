// ─────────────────────────────────────────────────────────────────────────────
// NQ / MNQ Evening Scalper  —  Multi-Signal Framework  (v2)
// Chart: NQ1! or MNQ1!  |  Timeframe: 5S (5-second bars)
//
// Signal stack:
//   1. EMA cross on 5-sec bars    — fast/slow cross as entry trigger
//   2. Trend bias on 1-min bars   — price above/below a single EMA (not a cross)
//   3. ATR volatility gate        — blocks dead / choppy zones
//
// Exits:
//   • ATR-based stop loss  (sl_k × ATR, captured at entry)
//   • ATR-based take profit (tp_k × ATR, captured at entry)
//   • Stop-and-reverse     — opposite signal closes and flips
//   • Session end          — force flat
// ─────────────────────────────────────────────────────────────────────────────
//@version=6
strategy("NQ Evening Scalper — Multi-Signal",
         shorttitle             = "NQ-EMS",
         overlay                = true,
         pyramiding             = 0,
         calc_on_every_tick     = false,
         default_qty_type       = strategy.fixed,
         default_qty_value      = 1,
         initial_capital        = 50000,
         commission_type        = strategy.commission.cash_per_contract,
         commission_value       = 0.62,
         slippage               = 2)

// ── INPUTS ─────────────────────────────────────────────────────────────────────

var g_sess = "Session"
sess_open  = input.string("1759", "Open  (HHMM, Exchange TZ)", group=g_sess)
sess_close = input.string("2059", "Close (HHMM, Exchange TZ)", group=g_sess)

var g_ema = "Entry Signal  (EMA Cross on chart TF)"
fast_len = input.int(8,  "Fast EMA (bars)", minval=2,  maxval=100, group=g_ema,
           tooltip="8 bars × 5 sec = 40-second EMA. Controls responsiveness.")
slow_len = input.int(21, "Slow EMA (bars)", minval=5,  maxval=300, group=g_ema,
           tooltip="21 bars × 5 sec = 105-second EMA (~1.75 min). Cross with fast EMA is the entry trigger.")

var g_bias = "Trend Bias  (single EMA on higher TF)"
bias_tf  = input.timeframe("1", "Timeframe", group=g_bias,
           tooltip="1-min is recommended. Price above this EMA = bullish bias, below = bearish.")
bias_len = input.int(20, "EMA Period",   minval=3, maxval=200, group=g_bias,
           tooltip="20-period on 1-min = 20-minute trend reference. Keeps direction bias flexible.")

var g_vol = "Volatility Gate  (ATR)"
atr_len  = input.int  (14,  "ATR Length (bars)",              minval=3,   group=g_vol)
atr_gate = input.float(0.8, "Gate: ATR ≥ this × 50-bar median", minval=0.1, step=0.05, group=g_vol,
           tooltip="Blocks dead zones. Raise to trade less; lower to trade more.")

var g_exit = "Exit"
sl_k   = input.float(1.5,  "Stop Loss   (× ATR)", minval=0.3, step=0.1, group=g_exit)
tp_k   = input.float(2.0,  "Take Profit (× ATR)", minval=0.5, step=0.1, group=g_exit)
use_sar = input.bool(true, "Stop-and-Reverse on opposite signal", group=g_exit)

// ── CALCULATIONS ───────────────────────────────────────────────────────────────

// 1. Fast/slow EMA on 5-second chart bars
fast_ema = ta.ema(close, fast_len)
slow_ema = ta.ema(close, slow_len)

ema_cross_up   = ta.crossover (fast_ema, slow_ema)   // bullish cross
ema_cross_down = ta.crossunder(fast_ema, slow_ema)   // bearish cross

// 2. Trend bias — is price above or below a single EMA on a higher TF?
bias_ema = request.security(syminfo.tickerid, bias_tf,
           ta.ema(close, bias_len), lookahead=barmerge.lookahead_off)

bull_bias = close > bias_ema
bear_bias = close < bias_ema

// 3. ATR volatility gate
atr        = ta.atr(atr_len)
atr_median = ta.sma(atr, 50)
vol_ok     = atr >= atr_median * atr_gate

// 4. Session
in_session = not na(time("1", sess_open + "-" + sess_close + ":23456"))

// ── SIGNALS ────────────────────────────────────────────────────────────────────
// Entry only on the bar where the cross fires, direction confirmed by bias and vol gate

long_sig  = ema_cross_up   and bull_bias and vol_ok and in_session
short_sig = ema_cross_down and bear_bias and vol_ok and in_session

is_flat  = strategy.position_size == 0
is_long  = strategy.position_size > 0
is_short = strategy.position_size < 0

// ── ENTRIES & STOP-AND-REVERSE ─────────────────────────────────────────────────
if long_sig
    if is_short and use_sar
        strategy.close("Short", comment="SAR")
    strategy.entry("Long", strategy.long, comment="▲")

if short_sig
    if is_long and use_sar
        strategy.close("Long", comment="SAR")
    strategy.entry("Short", strategy.short, comment="▼")

// ── BRACKET EXITS — fixed at entry ATR ────────────────────────────────────────
var float entry_atr = na

if is_flat[1] == false and is_flat  // just exited — reset
    entry_atr := na
if not is_long[1] and is_long        // just entered long
    entry_atr := atr
if not is_short[1] and is_short      // just entered short
    entry_atr := atr

if is_long and not na(entry_atr)
    strategy.exit("LX", "Long",
         stop           = strategy.position_avg_price - sl_k * entry_atr,
         limit          = strategy.position_avg_price + tp_k * entry_atr,
         comment_loss   = "SL",
         comment_profit = "TP")

if is_short and not na(entry_atr)
    strategy.exit("SX", "Short",
         stop           = strategy.position_avg_price + sl_k * entry_atr,
         limit          = strategy.position_avg_price - tp_k * entry_atr,
         comment_loss   = "SL",
         comment_profit = "TP")

// ── SESSION END ────────────────────────────────────────────────────────────────
if not in_session and not is_flat
    strategy.close_all(comment="EOD")

// ── PLOTS ──────────────────────────────────────────────────────────────────────

// Fast / slow EMAs on chart (the actual signal)
plot(fast_ema, "Fast EMA", color=color.new(color.yellow, 0), linewidth=1)
plot(slow_ema, "Slow EMA", color=color.new(color.white,  0), linewidth=2)

// Trend bias EMA from higher TF
plot(bias_ema, "Bias EMA (" + bias_tf + "m)", color=color.new(color.aqua, 0), linewidth=2)

// Highlight when fast is above slow (bullish on chart TF)
ema_bull = fast_ema > slow_ema
bgcolor(ema_bull and in_session ? color.new(color.green, 97) : not ema_bull and in_session ? color.new(color.red, 97) : na,
        title="EMA Bias Tint")

// Gray out when ATR gate is blocking
bgcolor(not vol_ok and in_session ? color.new(color.gray, 85) : na, title="Vol Gate Block")

// Session boundary
bgcolor(in_session ? color.new(color.blue, 96) : na, title="Session Window")

// Cross markers
plotshape(ema_cross_up   and in_session, "Bullish Cross", shape.triangleup,
          location.belowbar, color=color.new(color.green, 20), size=size.tiny)
plotshape(ema_cross_down and in_session, "Bearish Cross", shape.triangledown,
          location.abovebar, color=color.new(color.red,   20), size=size.tiny)

// Entry arrows (only new positions from flat)
plotshape(long_sig  and is_flat, "Long  Entry", shape.labelup,
          location.belowbar, color=color.green, text="L", textcolor=color.black, size=size.small)
plotshape(short_sig and is_flat, "Short Entry", shape.labeldown,
          location.abovebar, color=color.red,   text="S", textcolor=color.white, size=size.small)

// ── INFO TABLE ─────────────────────────────────────────────────────────────────
var table info = table.new(position.top_right, 2, 6,
     bgcolor=color.new(color.black, 65), border_width=1)

if barstate.islast
    cross_txt = ema_bull ? "▲ above slow" : "▼ below slow"
    cross_col = ema_bull ? color.lime : color.red
    bias_txt  = bull_bias ? "▲ BULL" : "▼ BEAR"
    bias_col  = bull_bias ? color.lime : color.red
    vol_txt   = vol_ok    ? "✓ ON" : "✗ BLOCKED"
    vol_col   = vol_ok    ? color.lime : color.orange
    sess_txt  = in_session ? "✓ ACTIVE" : "— CLOSED"
    sess_col  = in_session ? color.lime : color.gray
    pos_txt   = is_long    ? "LONG  ▲" : is_short ? "SHORT ▼" : "FLAT"
    pos_col   = is_long    ? color.lime : is_short ? color.red : color.gray

    table.cell(info, 0, 0, "Fast/Slow", text_color=color.silver, text_size=size.small)
    table.cell(info, 1, 0, cross_txt,   text_color=cross_col,    text_size=size.small, text_halign=text.align_left)
    table.cell(info, 0, 1, "Bias",      text_color=color.silver, text_size=size.small)
    table.cell(info, 1, 1, bias_txt,    text_color=bias_col,     text_size=size.small, text_halign=text.align_left)
    table.cell(info, 0, 2, "Vol Gate",  text_color=color.silver, text_size=size.small)
    table.cell(info, 1, 2, vol_txt,     text_color=vol_col,      text_size=size.small, text_halign=text.align_left)
    table.cell(info, 0, 3, "Session",   text_color=color.silver, text_size=size.small)
    table.cell(info, 1, 3, sess_txt,    text_color=sess_col,     text_size=size.small, text_halign=text.align_left)
    table.cell(info, 0, 4, "Position",  text_color=color.silver, text_size=size.small)
    table.cell(info, 1, 4, pos_txt,     text_color=pos_col,      text_size=size.small, text_halign=text.align_left)
    table.cell(info, 0, 5, "R:R",       text_color=color.silver, text_size=size.small)
    table.cell(info, 1, 5, str.format("{0,number,#.##}:1  SL={1,number,#.#}× TP={2,number,#.#}×",
               tp_k / sl_k, sl_k, tp_k),
               text_color=color.white, text_size=size.small, text_halign=text.align_left)
